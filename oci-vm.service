[Unit]
Description=OCI A1 Capacity Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/oci-a1-capacity
Environment="PATH=%h/venvs/oci-official/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=%h/oci-a1-capacity/run.sh local_runner.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
